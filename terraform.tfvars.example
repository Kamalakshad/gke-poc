# Example Environment Configuration Template
project_id = "your-gcp-project-id"
region     = "asia-south1"
prefix     = "kd"

# Network CIDRs
subnet_cidr   = "10.10.0.0/24"
pods_cidr     = "10.20.0.0/16"
services_cidr = "10.30.0.0/20"

# GKE Control Plane CIDR
master_ipv4_cidr_block = "172.16.0.0/28"

# GKE Cluster Settings
release_channel         = "REGULAR"
enable_private_endpoint = false
deletion_protection     = false
enable_flow_logs        = false

# Master Authorized Networks (Example: specify admin corporate IP / VPN)
master_authorized_networks = [
  # {
  #   cidr_block   = "203.0.113.10/32"
  #   display_name = "Office-VPN-Gateway"
  # }
]

# Ray Operator Configuration (Distributed AI/ML Workloads)
# Requires GKE cluster version >= 1.30.0-gke.1747000
enable_ray_operator           = true
enable_ray_cluster_logging    = true  # Sends Ray logs to Cloud Logging
enable_ray_cluster_monitoring = true  # Exports metrics to Managed Prometheus
